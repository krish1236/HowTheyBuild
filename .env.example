# Postgres (local dev via docker-compose)
DATABASE_URL=postgresql://htb:htb@localhost:5435/howtheybuild

# Server-side secret used to hash client IPs (any random string, kept private)
IP_HASH_SECRET=change-me-to-a-long-random-string

# LLM / retrieval providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
COHERE_API_KEY=

# Cache. Local docker-compose redis is on host port 6380.
# Leave blank to disable caching entirely; pipeline still works.
REDIS_URL=redis://localhost:6380

# Pinned model identifiers — never use "-latest"
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MODEL_FAST=claude-haiku-4-5-20251001
OPENAI_EMBED_MODEL=text-embedding-3-small
COHERE_RERANK_MODEL=rerank-v3.5
